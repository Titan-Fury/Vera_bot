# Critic v2 + WhatsApp delivery demo configuration.
# Copy to .env (or merge) before tomorrow's live test.
#
# IMPORTANT: never commit .env to git. .env is in .gitignore. .env.demo is
# safe to commit because it has no secrets.

# ============================================================================
# Critic v2 (the rubric upgrade)
# ============================================================================
CRITIC_V2_ENABLED=1
CRITIC_NUM_DRAFTS=3
CRITIC_COMPLIANCE_HARD_BLOCK=5
CRITIC_WEIGHTED_THRESHOLD=6.5
SELF_CRITIQUE_URGENCY_THRESHOLD=2
SELF_CRITIQUE_BUDGET_S=4.0
SELF_CRITIQUE_MAX_COMPOSE_ELAPSED_S=6.0

# ============================================================================
# LLM provider (pick one)
# ============================================================================
LLM_PROVIDER=openrouter-gemma
LLM_MODEL=google/gemma-3n-e4b-it:free
LLM_FALLBACKS=openrouter:openai/gpt-oss-20b:free|openrouter-gemma:google/gemma-3-12b-it:free
OPENROUTER_API_KEY=
# Or Groq (faster, separate quota):
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=

# ============================================================================
# WhatsApp delivery
# ============================================================================
# Provider: 'console' (dry run, prints to stdout) | 'cloud' (Meta WhatsApp Cloud API)
WHATSAPP_PROVIDER=console
# Force dry run regardless of provider (override for safety)
# WHATSAPP_DRY_RUN=1

# Meta WhatsApp Cloud API credentials. See docs/WHATSAPP_SETUP.md
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v20.0
WHATSAPP_CLOUD_TIMEOUT_S=8.0

# ============================================================================
# Safety guards (defaults shown)
# ============================================================================
# At most 1 message per recipient per N minutes
DELIVERY_RATE_LIMIT_PER_RECIPIENT_MIN=60
# Hard cap on total sends in any rolling 24h window across the process
DELIVERY_DAILY_CAP=50
# Where to persist opt-out records
DELIVERY_OPT_OUT_FILE=./data/opt_out.jsonl
# Where to log every delivery attempt
DELIVERY_LOG_FILE=./data/send_log.jsonl
DATA_DIR=./data

# ============================================================================
# Server
# ============================================================================
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
TICK_CONCURRENCY=2

# ============================================================================
# Identity (optional)
# ============================================================================
TEAM_NAME=Omni Bot
TEAM_MEMBERS=Demo
CONTACT_EMAIL=demo@local
APPROACH=Critic v2 (7-axis rubric, weighted, multi-draft pick-best, compliance hard-block) with Meta WhatsApp Cloud delivery and per-recipient safety guards.
