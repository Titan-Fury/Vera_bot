# Vera Engagement Bot - environment variables
# Copy to `.env` and fill what you need. Only ONE provider is required.

# --- LLM provider selection -------------------------------------------------
# Options: gemini | openrouter | perplexity | groq | together | ollama | dummy
# Leave blank to auto-detect from the keys below.
LLM_PROVIDER=
# Optional model override (e.g. llama-3.3-70b-versatile).
LLM_MODEL=
# Optional fallback chain. Format: <provider>:<model> separated by |.
# Model may contain colons (e.g. google/gemma-3n-e4b-it:free).
# Recommended for free-tier robustness:
# LLM_FALLBACKS=openrouter-gemma:google/gemma-3n-e4b-it:free|openrouter:openai/gpt-oss-20b:free|ollama:qwen2.5:7b-instruct
LLM_FALLBACKS=

# --- Provider credentials (set ONE) ----------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OLLAMA_HOST=http://localhost:11434

OPENROUTER_REFERER=https://magicpin.in

# --- Submission metadata ---------------------------------------------------
TEAM_NAME=Team Beta
TEAM_MEMBERS=Agent
CONTACT_EMAIL=team@example.com
APPROACH=Per-trigger-kind prompt routing with post-LLM validation over a pluggable multi-provider composer.

# --- Server ops ------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
